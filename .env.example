# ==============================================================================
# Alpha Kids Platform - Environment Variables Template
# ==============================================================================
# Salin berkas ini menjadi .env.local dan isi nilai kredensial yang sesuai.
# JANGAN PERNAH commit berkas .env.local yang berisi kunci rahasia ke Git repository!

# ------------------------------------------------------------------------------
# 1. Supabase Configuration & Database URL (Drizzle ORM)
# ------------------------------------------------------------------------------
# Diperoleh dari: Supabase Dashboard > Project Settings > Database > Connection String (URI)
DATABASE_URL="postgresql://postgres.[project-ref]:[YOUR-PASSWORD]@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres"

# Diperoleh dari: Supabase Dashboard > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-or-anon-key

# Server-only: Kunci ini TIDAK BOLEH berawalan NEXT_PUBLIC_ dan hanya digunakan di server
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# ------------------------------------------------------------------------------
# 2. Application Configuration
# ------------------------------------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ------------------------------------------------------------------------------
# 3. Payment Gateway: Midtrans
# ------------------------------------------------------------------------------
# Diperoleh dari: Midtrans Dashboard > Settings > Access Keys
NEXT_PUBLIC_MIDTRANS_CLIENT_KEY=SB-Mid-client-xxxxxxxxxxxx
MIDTRANS_SERVER_KEY=SB-Mid-server-xxxxxxxxxxxx
MIDTRANS_IS_PRODUCTION=false

# ------------------------------------------------------------------------------
# 4. Payment Gateway: Mayar
# ------------------------------------------------------------------------------
# Diperoleh dari: Mayar Dashboard > Integrasi / API
MAYAR_API_KEY=your-mayar-api-key
MAYAR_WEBHOOK_SECRET=your-mayar-webhook-secret
MAYAR_BASE_URL=https://api.mayar.id/hl/v1

# ------------------------------------------------------------------------------
# 5. Transactional Email (Opsional / Fase Lanjutan)
# ------------------------------------------------------------------------------
RESEND_API_KEY=re_xxxxxxxxxxxx
EMAIL_FROM="Alpha Kids <no-reply@alphakids.id>"
